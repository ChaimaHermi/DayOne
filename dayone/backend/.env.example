# Copier ce fichier en .env puis adapter les valeurs.

APP_NAME=DayOne API
ENVIRONMENT=development

# Format SQLAlchemy + driver psycopg (v3)
DATABASE_URL=postgresql+psycopg://dayone:dayone@localhost:5432/dayone

# Origines autorisées (séparées par des virgules). "*" = tout autoriser (dev uniquement).
CORS_ORIGINS=*

# Secret de signature des jetons de session (à changer hors du développement).
JWT_SECRET=change-me
JWT_EXPIRE_DAYS=7
